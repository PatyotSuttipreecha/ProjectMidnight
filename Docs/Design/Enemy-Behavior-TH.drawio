        </mxCell>
        <mxCell id="attack" value="เลือกการโจมตีตามระยะ&#10;ระยะใกล้ → Preparation / Attack&#10;ระยะกลาง → Charge ถ้า Profile เปิด&#10;รายละเอียด Charge อยู่หน้า 4" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#607080;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="850" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="recover" value="Recovery&#10;พักหลังตี / พลาด / รอ projectile&#10;ไม่แย่ง turn จากท่าที่เริ่มแล้ว" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#607080;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1">
