        <mxCell id="permission" value="ได้รับ attack turn A+ แล้ว?&#10;และพ้น shared start interval&#10;เป้าหมายรับการโจมตีได้" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#607080;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1">
