        </mxCell>
        <mxCell id="return" value="คืน attack turn แล้วประเมินใหม่&#10;[จุดวนรอบ B · เข้ารอบต่อสู้]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#607080;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1">
