<mxfile host="app.diagrams.net">
  <diagram id="combat-simple" name="Combat - สิทธิ์เดียว">
    <mxGraphModel dx="1100" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="1100">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Enemy Combat — กลุ่มให้สิทธิ์ / ตัวศัตรูเลือกท่า" style="text;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="a" value="พบผู้เล่น / เคลื่อนที่เข้าหา" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="b" value="กลุ่มให้ Combat Turn หรือยัง?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="200" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="wait" value="ยังไม่ได้: Pressure / เดินรอช่องเข้าทำ&#xa;ตรวจใหม่ในเฟรมถัดไป" style="rounded=1;whiteSpace=wrap;fillColor=#eeeeee;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="c" value="ได้แล้ว: ระยะ Charge ใช้ได้&#xa;และสุ่มเลือกท่านี้?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="melee" value="ไม่เลือก: เดินปิดระยะ&#xa;เตรียมโจมตีประชิด" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="charge" value="เลือก: เตรียม Charge&#xa;พุ่งไปจุดที่กำหนด" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="780" y="530" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="hit" value="โจมตี / จับโดน หรือพลาด&#xa;จับโดน: บล็อกการเริ่มโจมตีของกลุ่ม" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="670" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="end" value="Recovery → คืน Combat Turn" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="800" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="note" value="P+ = Movement Slot: คุมการวิ่งและวง Pressure เท่านั้น&#xa;A+ = Combat Turn: สิทธิ์โจมตีชุดเดียว&#xa;ไม่มี Escape pause: ไล่ต่อ และส่งต่อเฉพาะตัวที่ตามไม่ทัน&#xa;การสุ่ม Charge ไม่มีส่วนในการแจกสิทธิ์" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;align=left;spacing=15;fontSize=16;" vertex="1" parent="1"><mxGeometry x="130" y="910" width="840" height="130" as="geometry"/></mxCell>
        <mxCell id="ab" edge="1" parent="1" source="a" target="b" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bw" value="รอ" edge="1" parent="1" source="b" target="wait" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bc" value="ได้สิทธิ์" edge="1" parent="1" source="b" target="c" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cm" edge="1" parent="1" source="c" target="melee" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cc" edge="1" parent="1" source="c" target="charge" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mh" edge="1" parent="1" source="melee" target="hit" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch" edge="1" parent="1" source="charge" target="hit" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.5;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he" edge="1" parent="1" source="hit" target="end" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
