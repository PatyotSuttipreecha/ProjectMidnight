        <mxCell id="gap" value="Player walks away + owner uncommitted&#10;Outside pressure range&#10;Gap grows &gt;= 0.5 m over 2.5 s?" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
