<mxfile host="app.diagrams.net" type="device"><diagram id="the-lost-onepage" name="The Lost — One Page"><mxGraphModel dx="1400" dy="1050" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="THE LOST — พฤติกรรม + Weapon Module" style="text;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="ทุกตัวใช้ Base ร่วมกัน • อาวุธเปลี่ยนวิธีโจมตี • อาวุธหลุดแล้วกลับมือเปล่า&#10;ผังเป้าหมายดีไซน์ — จำนวน / Damage / เวลา / Chance ปรับและทดสอบได้" style="text;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="65" as="geometry"/></mxCell><mxCell id="idle" value="Idle / Patrol&#10;เดินวน • คลำทาง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="170" width="240" height="60" as="geometry"/></mxCell><mxCell id="detect" value="Detect&#10;หันตรวจเสียง / การเคลื่อนไหว" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="260" width="240" height="65" as="geometry"/></mxCell><mxCell id="confirmed" value="ยืนยันตำแหน่งมิน?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="355" width="200" height="85" as="geometry"/></mxCell><mxCell id="search" value="Search&#10;ตรวจจุดเสียง / ตำแหน่งล่าสุด&#10;ไม่รู้ตำแหน่งผ่านกำแพง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="220" height="90" as="geometry"/></mxCell><mxCell id="chase" value="Chase&#10;ตามมิน / เข้าให้ถึงระยะ Module" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="475" width="240" height="70" as="geometry"/></mxCell><mxCell id="gate" value="ระยะ + ทางถึง + สิทธิ์โจมตี&#10;พร้อมหรือยัง?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="295" y="585" width="230" height="95" as="geometry"/></mxCell><mxCell id="pressure" value="Pressure / Approach&#10;ยังตามและขยับกดดัน&#10;ไม่ลงมือพร้อมกันทุกตัว" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="580" width="235" height="95" as="geometry"/></mxCell><mxCell id="prep" value="Preparation&#10;เลือกท่าตามอาวุธที่ถือ&#10;เตือนก่อนโจมตี" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d7e9fa;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="720" width="240" height="75" as="geometry"/></mxCell><mxCell id="attack" value="Attack&#10;ทำท่าและผลของ Module" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8d9d5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="830" width="240" height="65" as="geometry"/></mxCell><mxCell id="recover" value="Recovery&#10;พัก / ตั้งหลัก → ประเมินใหม่" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="925" width="240" height="60" as="geometry"/></mxCell><mxCell id="return" value="Return&#10;ค้นไม่พบ → กลับเส้นทางวน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="220" height="65" as="geometry"/></mxCell><mxCell id="weapons" value="อาวุธที่ถือ = Attack Module&#10;&#10;มือเปล่า → ตี / จับรั้งสั้น&#10;&#10;มาเชเต้ + ท่อนไม้ → ท่ากวาดเดียวกัน&#10;ระยะกว้างขึ้น • Damage แยก&#10;&#10;ขวานใหญ่ → เตรียมนาน / ฟันหนัก / พักนาน&#10;&#10;ก้อนหิน → ระยะไกล / เตรียมขว้าง&#10;ข้อเสนอ: 1 ก้อน → หมดแล้วกลับ Base&#10;&#10;คบเพลิง → ท่าเดียวกับไม้ + ไฟลุก&#10;ข้อเสนอ: 3 วิ • ต่อเวลา ไม่ซ้อนหลายชุด" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e3eef8;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="865" y="170" width="470" height="420" as="geometry"/></mxCell><mxCell id="hit" value="แทรกจากทุก State: ถูกโจมตี&#10;ตรวจ Damage / Hit reaction / โอกาสอาวุธหลุด&#10;&#10;หลุด → ยกเลิกท่าอาวุธ → กลับ Base&#10;ตั้งหลักก่อนโจมตีใหม่ • ไม่คว้าทันที&#10;ตาย → จบพฤติกรรม / คืนสิทธิ์" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8d9d5;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="865" y="625" width="470" height="160" as="geometry"/></mxCell><mxCell id="rules" value="กฎร่วมของกลุ่ม&#10;เริ่มผู้เข้าตี 1 ตัว (ปรับได้) รวมการขว้าง&#10;ตัวอื่นกดดัน / หลบกัน ไม่ทะลุเพื่อน&#10;คืนสิทธิ์เมื่อจบ / สะดุด / ตาย / Timeout&#10;ไม่จับ–ตีซ้อนจนมินขยับไม่ได้" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1eddf;strokeColor=#64748b;fontColor=#142235;fontFamily=Noto Sans Thai;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="865" y="820" width="470" height="150" as="geometry"/></mxCell><mxCell id="a" value="พบสิ่งผิดปกติ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#52657c;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="idle" target="detect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#52657c;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="detect" target="confirmed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#52657c;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="confirmed" target="chase"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d" value="ไม่ / รู้เพียงจุดเสียง" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#52657c;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="confirmed" target="search"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="395"/></Array></mxGeometry></mxCell><mxCell id="f" value="พบมิน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#52657c;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="search" target="chase"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g" 