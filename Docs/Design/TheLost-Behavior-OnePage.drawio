<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="the-lost-onepage" name="The Lost — Updated States"><mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="THE LOST — State Flow / Normal + Aggressive" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1440" height="45" as="geometry"/></mxCell><mxCell id="sub" value="อัปเดตตาม Program - Coding • Approach = ได้สิทธิ์เข้าประชิด / Pressure = รอสิทธิ์และเดินวน&#10;Aggressive เป็นโหมดครอบพฤติกรรมสำหรับฉากไล่ต้อน — อยู่ระหว่างพัฒนา ณ รอบที่ตรวจ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1440" height="60" as="geometry"/></mxCell><mxCell id="idle" value="Idle / Patrol&#10;เดินวน / พักตามเส้นทาง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="250" height="60" as="geometry"/></mxCell><mxCell id="detect" value="Detect&#10;ตรวจเสียง / การเคลื่อนไหว" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="250" height="60" as="geometry"/></mxCell><mxCell id="confirm" value="ยืนยันตำแหน่งมิน?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="345" width="250" height="85" as="geometry"/></mxCell><mxCell id="search" value="Search&#10;ตรวจจุดเสียง / ตำแหน่งล่าสุด&#10;ค้นไม่พบ → กลับ Patrol" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="395" y="240" width="290" height="85" as="geometry"/></mxCell><mxCell id="chase" value="Chase&#10;ไล่ตามเข้าเขตต่อสู้" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="250" height="65" as="geometry"/></mxCell><mxCell id="aggr" value="Aggressive ON&#10;ล็อกเป้าหมายมินทันที&#10;รู้ตำแหน่งปัจจุบัน / ข้าม Detect + Search" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f4dfef;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="705" y="165" width="290" height="100" as="geometry"/></mxCell><mxCell id="turn" value="ได้รับสิทธิ์โจมตี?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="585" width="250" height="90" as="geometry"/></mxCell><mxCell id="pressure" value="Pressure&#10;เดินวนรอบมิน / หันมองมิน&#10;วงเริ่ม 1.8 ม. (ขึ้นกับทางและระยะตัว)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1eddf;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="720" width="280" height="90" as="geometry"/></mxCell><mxCell id="approach" value="Approach&#10;ได้สิทธิ์แล้ว → เข้าระยะ Module&#10;ต้องมีทาง / ระยะ / แนวโจมตีถูกต้อง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d7e9fa;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="590" width="310" height="85" as="geometry"/></mxCell><mxCell id="prep" value="Preparation&#10;ท่าเตือนตามอาวุธ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d7e9fa;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="715" width="310" height="65" as="geometry"/></mxCell><mxCell id="attack" value="Attack&#10;ผลตาม Base / Weapon Module" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8d9d5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="825" width="310" height="65" as="geometry"/></mxCell><mxCell id="recovery" value="Recovery&#10;พัก / คืนสิทธิ์ตามวงจรโจมตี&#10;ประเมินเป้าหมายและสิทธิ์ใหม่" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="940" width="310" height="85" as="geometry"/></mxCell><mxCell id="retreat" value="Retreat → Patrol&#10;Normal: รอเกิน 15 วิ → ถอนตัว&#10;พักรับรู้ 8 วิ • Timeout = 0 ไม่ถอน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="935" width="280" height="90" as="geometry"/></mxCell><mxCell id="normal" value="NORMAL: เสียการมองเห็นจริง → Search&#10;รวมตอน Pressure เช่น มินอยู่หลังกำแพง&#10;เห็นไม่หลุดเพียงเพราะเดินวนหันข้าง" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eef5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="345" width="640" height="95" as="geometry"/></mxCell><mxCell id="mode" value="AGGRESSIVE: ไม่ Search / ไม่ถอนเพราะรอนาน&#10;ยังใช้ NavMesh + สิทธิ์โจมตี / ตีผ่านกำแพงไม่ได้&#10;ปิดโหมด → กลับระบบรับรู้ปกติ&#10;ตั้งผ่าน Profile / Spawn override / Enemy Group&#10;รายละเอียดการเชื่อมกลุ่มยังอยู่ระหว่างพัฒนา" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f4dfef;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="480" width="640" height="150" as="geometry"/></mxCell><mxCell id="weapons" value="Attack Module&#10;มือเปล่า: ตี / รั้งสั้น&#10;มาเชเต้ + ไม้: ท่ากวาดร่วม / Damage แยก&#10;ขวานใหญ่: เตรียมนาน / ฟันหนัก / พักนาน&#10;หิน: ขว้างไกล → ใช้หมดกลับ Base&#10;คบเพลิง: ท่าไม้ + ไฟลุก (เวลา configurable)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e3eef8;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="680" width="640" height="180" as="geometry"/></mxCell><mxCell id="hit" value="แทรกทุก State: Hit reaction / อาวุธหลุด / Dead&#10;อาวุธหลุด → ยกเลิกท่า / คืนสิทธิ์ / กลับ Base&#10;พักก่อนโจมตีใหม่ • ตาย → จบพฤติกรรม&#10;กลุ่มจำกัดผู้ลงมือ รวมการขว้าง / ไม่จับ–ตีซ้อนล็อกมิน" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8d9d5;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="910" width="640" height="125" as="geometry"/></mxCell><mxCell id="foot" value="ค่าระยะและเวลาเป็นค่าเริ่มต้น ปรับใน Group Engagement • ผังแสดงลำดับพฤติกรรม ไม่ยืนยันผลแอนิเมชันหรือสมดุลฉากหลัก" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontFamily=Tahoma;fontSize=16;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1120" width="1440" height="45" as="geometry"/></mxCell><mxCell id="a" value="ผิดปกติ" source="idle" target="detect" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="b" value="" source="detect" target="confirm" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c" value="ใช่" source="confirm" target="chase" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="d" value="ไม่ / จุดเสียง" source="confirm" target="search" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="387"/><mxPoint x="365" y="282"/></Array></mxGeometry></mxCell><mxCell id="f" value="พบมิน" source="search" target="chase" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="500"/></Array></mxGeometry></mxCell><mxCell id="g" value="ค้นไม่พบ" source="search" target="idle" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="190"/></Array></mxGeometry></mxCell><mxCell id="h" value="ข้ามตรวจจับ" source="aggr" target="chase" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="215"/><mxPoint x="760" y="505"/></Array></mxGeometry></mxCell><mxCell id="i" value="เข้าเขตต่อสู้" source="chase" target="turn" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="j" value="ยังไม่ได้" source="turn" target="pressure" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="k" value="ได้สิทธิ์" source="turn" target="approach" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="l" value="ได้รับสิทธิ์" source="pressure" target="approach" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="765"/><mxPoint x="380" y="655"/></Array></mxGeometry></mxCell><mxCell id="m" value="Normal: รอนาน" source="pressure" target="retreat" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="n" value="พักรับรู้" source="retreat" target="idle" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="980"/><mxPoint x="35" y="190"/></Array></mxGeometry></mxCell><mxCell id="o" value="พร้อมโจมตี" source="approach" target="prep" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="p" value="" source="prep" target="attack" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="q" value="" source="attack" target="recovery" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="r" value="ตามต่อ / ขอสิทธิ์ใหม่" source="recovery" target="turn" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="982"/><mxPoint x="780" y="557"/><mxPoint x="195" y="557"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>