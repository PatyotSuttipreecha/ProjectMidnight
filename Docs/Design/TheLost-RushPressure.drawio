        <mxCell id="confirmed" parent="1" value="TARGET CONFIRMED&#10;Player is not escaping" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#e7f1ff;strokeColor=#8aabd6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="90" y="250" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="initial" parent="1" value="RANDOM INCOMING RUNNERS&#10;55% willing per enemy / once per round&#10;Stagger starts 0.3-0.7 s; shared cap 3" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#e7f1ff;strokeColor=#8aabd6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="90" y="360" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="admit" parent="1" value="FIRST ELIGIBLE ARRIVAL CLAIMS&#10;Walkers and runners may claim a place&#10;Within 4.5 m / maximum 3 owners" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#e7f1ff;strokeColor=#8aabd6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="90" y="520" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="established" parent="1" value="PRESSURE GROUP ESTABLISHED&#10;Owners keep the right to pursue&#10;Other enemies walk / wait outside" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#d9ece5;strokeColor=#79ab94;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="90" y="680" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="combat" parent="1" value="APPROACH / PRESSURE&#10;PREPARATION → ATTACK → RECOVERY&#10;Ownership persists through every phase&#10;Attack slots + start timing still apply" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#d9ece5;strokeColor=#79ab94;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="90" y="845" width="420" height="132" as="geometry" />
        </mxCell>
        <mxCell id="keep-note" parent="1" value="Reaching the player, preparing, or&#10;finishing an attack does not free a place.&#10;The group stays established after a hit." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#15283b;fillColor=#ffffff;strokeColor=#d9e1ea;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="70" y="1035" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="invalid" parent="1" value="OWNER INTERRUPTED / INVALID&#10;Hit or stagger / death / paused AI&#10;Target lost / pursuit path fails" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#fff0df;strokeColor=#d2a272;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="650" y="250" width="420" height="112" as="geometry" />
        </mxCell>
        <mxCell id="release" parent="1" value="FREE ONLY THIS PLACE&#10;Keep the remaining owners&#10;Keep the established-group latch" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#fff0df;strokeColor=#d2a272;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="650" y="420" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="replacement-wait" parent="1" value="REPLACEMENT INTERVAL&#10;Wait 0.6 s between replacements&#10;Released owner rests for 2 s" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#fff0df;strokeColor=#d2a272;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="650" y="574" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="nearest" parent="1" value="FIRST ARRIVING REPLACEMENT&#10;Must enter the radius on a valid path&#10;Admit one vacancy at a time" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#fff0df;strokeColor=#d2a272;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="650" y="730" width="420" height="112" as="geometry" />
        </mxCell>
        <mxCell id="refill" parent="1" value="REJOIN THE PRESSURE GROUP&#10;Fill only the vacant places&#10;No distant runner reserves pressure" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#d9ece5;strokeColor=#79ab94;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="650" y="900" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stall-note" parent="1" value="Stall timeout applies to active pursuit.&#10;Do not expire deliberate circling,&#10;attacking, recovery or an escape pause." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#15283b;fillColor=#ffffff;strokeColor=#d9e1ea;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="630" y="1035" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="escape" parent="1" value="PLAYER SPRINTS AWAY&#10;Actual movement takes the player away&#10;from an engaged threat" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#e3f4ee;strokeColor=#7eaf9e;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1210" y="250" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="pause" parent="1" value="ESCAPE PAUSE&#10;Walk after player / no Rush&#10;Pause new admissions / replacements&#10;Keep the current owners" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#e3f4ee;strokeColor=#7eaf9e;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1210" y="400" width="420" height="112" as="geometry" />
        </mxCell>
        <mxCell id="resume-wait" parent="1" value="SPRINTING STOPS&#10;Wait 0.8 s before running resumes&#10;Keep paused while sprinting continues" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#e3f4ee;strokeColor=#7eaf9e;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1210" y="572" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="owners" parent="1" value="CLEAR OLD PRESSURE OWNERS&#10;Clear runners / arrivals / random choices&#10;No reentry penalty for this reset" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#15283b;fillColor=#fff5d6;strokeColor=#ccb16c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1210" y="740" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="escape-note" parent="1" value="Keep walking; current attacks may finish.&#10;This opens a chance to escape;&#10;existing attacks can still hit." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#15283b;fillColor=#ffffff;strokeColor=#d9e1ea;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1190" y="1070" width="460" height="78" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" value="SHARED COMBAT SETTINGS  /  System Modification → Enemy Lab → Shared Combat Settings&#10;Shared cap: 3   •   Radius: 4.5 m   •   Run chance: 55%   •   Start stagger: 0.3-0.7 s&#10;Replacement: 0.6 s   •   Reentry: 2 s   •   Escape resume: 0.8 s   •   Attack start: 0.8 s" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#15283b;fillColor=#eef3f9;strokeColor=#d9e1ea;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="40" y="1210" width="1640" height="112" as="geometry" />
        </mxCell>
        <mxCell id="restart" parent="1" value="RESTART RANDOM APPROACH&#10;Reroll willingness / stagger new runners&#10;First arrivals claim new pressure slots" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#15283b;fillColor=#e7f1ff;strokeColor=#8aabd6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1">
