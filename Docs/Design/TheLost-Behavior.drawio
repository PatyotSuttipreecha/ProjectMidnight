  <diagram name="03 — Variants &amp; Sources" id="03-—-Variants-&amp;-Sources">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03 — Variants &amp; Sources" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=5;strokeColor=none;fillColor=#ffffff;strokeColor=#475569;fontColor=#182230;fontSize=26;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1120" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="The Lost • วงจรพื้นฐานร่วมกัน แต่ภัยที่ผู้เล่นต้องรับมือต่างกัน&#xa;รูปแบบย่อยด้านล่างเป็นข้อเสนอจากแชท Design ยังไม่ถือว่าได้อนุมัติหรือทำครบแล้ว" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=5;strokeColor=none;fillColor=#ffffff;strokeColor=#475569;fontColor=#182230;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="70" width="1120" height="65" />
        </mxCell>
        <mxCell id="base" value="พื้นฐานร่วม: เดินวน → รับรู้ → ค้นหา → ตาม → พยายามรั้งมิน → พัก / กลับวน" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=10;fontFamily=Tahoma;strokeWidth=2;fillColor=#dae8fc;strokeColor=#475569;fontColor=#182230;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="1080" height="80" />
        </mxCell>
        <mxCell id="unarmed" value="มือเปล่า&#xa;&#xa;ตามเข้าระยะใกล้&#xa;ยกมือก่อนคว้า&#xa;คว้าพลาดแล้วเปิดช่องให้หนี&#xa;&#xa;รับมือ: รักษาระยะ / เคลื่อนข้าง" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=10;fontFamily=Tahoma;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#475569;fontColor=#182230;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="330" width="320" height="230" />
        </mxCell>
        <mxCell id="stick" value="ถือไม้เท้า&#xa;&#xa;คลำทางขณะเดิน&#xa;กวาดไม้รั้งในระยะไกลกว่า&#xa;เตรียมท่านานให้เห็น&#xa;&#xa;รับมือ: รอพลาดแล้วผ่านด้านข้าง" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=10;fontFamily=Tahoma;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#475569;fontColor=#182230;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="330" width="320" height="230" />
        </mxCell>
        <mxCell id="torch" value="ถือไฟฉาย&#xa;&#xa;หยุดตรวจและกวาดแสง&#xa;พบมิน → ร้องให้ตัวใกล้เคียงตรวจ&#xa;แล้วตามเข้าคว้า&#xa;&#xa;รับมือ: ใช้ฉากบัง / เปลี่ยนตำแหน่ง" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=10;fontFamily=Tahoma;strokeWidth=2;fillColor=#fff2cc;strokeColor=#475569;fontColor=#182230;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="330" width="320" height="230" />
        </mxCell>
        <mxCell id="v0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontFamily=Tahoma;fontSize=13;fontColor=#182230;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="base" target="unarmed">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="v1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontFamily=Tahoma;fontSize=13;fontColor=#182230;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="base" target="stick">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="v2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontFamily=Tahoma;fontSize=13;fontColor=#182230;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="base" target="torch">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="scope" value="ขอบเขตต้นแบบ&#xa;เริ่มจาก The Lost มือเปล่า 1 แบบก่อน: เดินตาม / เตือนก่อนคว้า / พลาดแล้วพัก&#xa;ไม่จับล็อกยาวหรือบังคับ QTE ในต้นแบบแรก&#xa;สิ่งที่ติดตัวต้องเปลี่ยนวิธีรับมือจริง ไม่ใช่แค่เปลี่ยนโมเดล" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=10;fontFamily=Tahoma;strokeWidth=2;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#182230;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="630" width="1080" height="130" />
        </mxCell>
        <mxCell id="source" value="แหล่งที่มาและสถานะ&#xa;• Design - Documentation: การสนทนา 12 Oct 2026 เรื่องผู้สูญหาย, วงจรพฤติกรรม, Chaos และรูปแบบย่อย&#xa;• GDD : Project Midnight: โลกเครือหลงและฉากเปิด (เอกสารที่อ่านยังไม่มีวงจร The Lost ล่าสุด)&#xa;• Docs/EnemyGroupCombat.md และ EnemyController.cs: ใช้เทียบฐานเทคนิค ไม่ใช้แทนดีไซน์&#xa;&#xa;ผังจัดทำ 13 Oct 2026 • เป็นภาพรวมเป้าหมายสำหรับคุยและทำต้นแบบ&#xa;ยังไม่ได้แก้โค้ด AI ให้ตรงผัง หรือกำหนด timing / damage / จำนวนศัตรูขั้นสุดท้าย" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=5;strokeColor=none;fillColor=#ffffff;strokeColor=#475569;fontColor=#182230;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="790" width="1080" height="170" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
